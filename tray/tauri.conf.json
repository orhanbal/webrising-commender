{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WECOMMANDER Center",
  "version": "0.1.0",
  "identifier": "app.wecommander.center",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WECOMMANDER Yönetim Merkezi",
        "width": 400,
        "height": 720,
        "minWidth": 320,
        "minHeight": 420,
        "visible": false,
        "center": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
