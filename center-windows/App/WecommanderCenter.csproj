<Project Sdk="Microsoft.NET.Sdk">
  <!-- WECOMMANDER Management Center for Windows: native WinUI 3 tray app.
       Unpackaged and self-contained (Windows App SDK included), so it runs
       without installing runtimes and without signing. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Wecommander.Center</RootNamespace>
    <AssemblyName>WecommanderCenter</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- PRI generation from the NuGet tooling, so the dotnet CLI can build without Visual Studio. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Version>0.1.0</Version>
    <Product>WECOMMANDER Yönetim Merkezi</Product>
    <Company>WebRising</Company>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.2.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\WecommanderCenter.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
