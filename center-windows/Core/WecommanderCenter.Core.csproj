<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral logic of the Windows Management Center: gateway client,
       settings, messages. Tested on any OS (Core.Tests). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wecommander.Center.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
