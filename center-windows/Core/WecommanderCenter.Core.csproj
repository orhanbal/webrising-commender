<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral logic of the Windows Management Center: gateway client,
       settings, messages. Tested on any OS (Core.Tests). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wecommander.Center.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Interface languages (L.cs): Turkish source text -> translation. -->
    <EmbeddedResource Include="Strings\*.json" LogicalName="Wecommander.Center.Core.Strings.%(Filename).json" />
    <!-- "Yenilikler" (what's new): the one source shared with macOS and the website (ReleaseNotes.cs). -->
    <EmbeddedResource Include="..\..\release-notes\notes.json" LogicalName="Wecommander.Center.Core.ReleaseNotes.notes.json" Link="ReleaseNotes\notes.json" />
  </ItemGroup>
</Project>
