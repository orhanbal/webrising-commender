# Gateway
POSTGRES_PASSWORD=replace-with-a-strong-database-password
PORT=8787
HOST=0.0.0.0
DATABASE_URL=postgres://commender:change-me@postgres:5432/commender
CONTROL_API_KEY=replace-with-at-least-32-random-bytes
APPROVAL_SIGNING_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_BASE_URL=http://localhost:8787
AGENT_REQUEST_TIMEOUT_MS=30000
AUDIT_RETENTION_DAYS=90
BROWSER_SESSION_HOURS=12
DEPLOYMENT_MODE=self_hosted
PUBLIC_SIGNUP_ENABLED=false
SIGNUP_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# First-party SMTP delivery. No external mail SaaS is required.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_HELO_NAME=commender.local
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_TIMEOUT_MS=10000

# Required when SMTP delivery is enabled. Generate 32 random bytes, e.g.:
# openssl rand -hex 32
MAIL_OUTBOX_KEY=
MAIL_DELIVERY_INTERVAL_MS=5000
MAIL_DELIVERY_BATCH=10
MAIL_MAX_ATTEMPTS=12
# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Agent example (prefer agent config file after enrollment)
COMMANDER_GATEWAY_URL=ws://localhost:8787/agent
COMMANDER_CONTROL_URL=http://localhost:8787
COMMANDER_ALLOWED_ROOTS=
