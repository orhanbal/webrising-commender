{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WECOMMANDER",
  "version": "0.1.0",
  "identifier": "app.wecommander.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WECOMMANDER",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "nsis",
      "app"
    ],
    "publisher": "WebRising",
    "category": "DeveloperTool",
    "shortDescription": "SSH terminals and WECOMMANDER agent control",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
